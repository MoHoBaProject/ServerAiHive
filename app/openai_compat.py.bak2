"""لایه‌ی سازگار با OpenAI روی AiHive (برای 9router / OmniRoute / Claude Code)."""
import asyncio
import json
import re
import time
import uuid

from fastapi import APIRouter, HTTPException, Request
from fastapi.responses import JSONResponse, StreamingResponse

MARK = "@@TOOL_CALL@@"
KEEPALIVE = 15
LOCKS = {}

TOOLS_HEAD = (
    "[TOOLS]\n"
    "You can use tools. To call a tool, write on its own line: "
    + MARK
    + ' {"name": "<tool name>", "arguments": {...}}\n'
    "It must be one line of plain JSON: no code block, no markdown, no extra text on that line. Use only plain ASCII straight double quotes in the JSON, never curly quotes, and no typographic dashes or ellipsis characters. Inside JSON strings every backslash must be written as two backslashes, e.g. the path C:\\Users\\a.txt must be written as C:\\\\Users\\\\a.txt. "
    "You may write several such lines. After the tool call lines, stop and wait for the results. "
    "Never invent tool results. If no tool is needed, answer normally.\n"
    "Available tools (JSON):\n"
)


def _lock(acc_id):
    return LOCKS.setdefault(acc_id, asyncio.Lock())


def _text(c):
    if c is None:
        return ""
    if isinstance(c, str):
        return c
    return "\n".join(
        p.get("text", "") for p in c if isinstance(p, dict) and p.get("type") in ("text", "input_text")
    )


def build_prompt(messages, tools):
    out = []
    sys_parts = [_text(m.get("content")) for m in messages if m.get("role") in ("system", "developer")]
    sys_parts = [s for s in sys_parts if s.strip()]
    if sys_parts:
        out.append("[SYSTEM INSTRUCTIONS]\n" + "\n\n".join(sys_parts))
    if tools:
        spec = []
        for t in tools:
            f = t.get("function", t)
            spec.append({"name": f.get("name"), "description": f.get("description", ""), "parameters": f.get("parameters", {})})
        out.append(TOOLS_HEAD + json.dumps(spec, ensure_ascii=False))
    out.append("[CONVERSATION]")
    for m in messages:
        role = m.get("role")
        if role in ("system", "developer"):
            continue
        if role == "user":
            out.append("User: " + _text(m.get("content")))
        elif role == "assistant":
            line = _text(m.get("content"))
            for tc in m.get("tool_calls") or []:
                f = tc.get("function", {})
                args = f.get("arguments") or "{}"
                if isinstance(args, str):
                    try:
                        args = json.loads(args)
                    except ValueError:
                        pass
                line += "\n" + MARK + " " + json.dumps({"name": f.get("name"), "arguments": args}, ensure_ascii=False)
            out.append("Assistant: " + line.strip())
        elif role == "tool":
            out.append("Tool result (call " + str(m.get("tool_call_id", "")) + "):\n" + _text(m.get("content")))
    out.append("Reply now as the assistant to the last message only.\nAssistant:")
    return "\n\n".join(out)


_PATH_RE = re.compile(r'(?<![A-Za-z0-9])[A-Za-z]:\\[^"\n]*')
_BS_RE = re.compile(r'\\\\|\\')
_ESC_RE = re.compile(r'\\(?:["\\/bfnrt]|u[0-9a-fA-F]{4})|\\')


def _fix_json(s):
    s = s.translate({0x201C: '"', 0x201D: '"'})
    s = _PATH_RE.sub(lambda m: _BS_RE.sub(lambda b: b.group(0) if len(b.group(0)) == 2 else "\\\\", m.group(0)), s)
    return _ESC_RE.sub(lambda e: e.group(0) if len(e.group(0)) > 1 else "\\\\", s)


def parse(text):
    first = text.find(MARK)
    if first == -1:
        return text.strip(), []
    dec, calls, i = json.JSONDecoder(), [], first
    while True:
        i = text.find(MARK, i)
        if i == -1:
            break
        j = i + len(MARK)
        while j < len(text) and text[j] in " \t\r\n":
            j += 1
        try:
            obj, end = dec.raw_decode(text, j)
        except ValueError:
            try:
                nl = text.find("\n", j)
                end = len(text) if nl == -1 else nl
                obj, _ = dec.raw_decode(_fix_json(text[j:end]))
            except ValueError:
                i = j
                continue
        if isinstance(obj, dict) and obj.get("name"):
            args = obj.get("arguments", {})
            calls.append({
                "id": "call_" + uuid.uuid4().hex[:24],
                "type": "function",
                "function": {"name": obj["name"], "arguments": args if isinstance(args, str) else json.dumps(args, ensure_ascii=False)},
            })
        i = end
    if not calls:
        return text.strip(), []
    return text[:first].strip(), calls


def make_router(mgr):
    r = APIRouter()

    def pick(model):
        accs = [a for a in mgr.accs.load() if a.provider == "claude"]
        if not accs:
            raise HTTPException(503, "no claude account")
        for a in accs:
            if model == "aihive-" + a.id:
                return a.id
        return accs[0].id

    async def run(acc_id, prompt):
        async with _lock(acc_id):
            s = await mgr.send(acc_id, prompt, True)
            if not s.get("ok"):
                raise RuntimeError("send failed: " + json.dumps(s, ensure_ascii=False))
            res = await mgr.reply(acc_id, 300)
            if not res.get("text", "").strip():
                raise RuntimeError("no reply: " + str(res.get("error", "empty")))
            return res["text"]

    @r.get("/v1/models")
    async def models():
        ids = ["aihive"] + ["aihive-" + a.id for a in mgr.accs.load() if a.provider == "claude"]
        return {"object": "list", "data": [{"id": i, "object": "model", "created": 0, "owned_by": "aihive"} for i in ids]}

    @r.post("/v1/chat/completions")
    async def chat(request: Request):
        body = await request.json()
        model = body.get("model") or "aihive"
        prompt = build_prompt(body.get("messages") or [], body.get("tools") or [])
        acc_id = pick(model)
        cid = "chatcmpl-" + uuid.uuid4().hex[:24]
        created = int(time.time())
        usage = {"prompt_tokens": len(prompt) // 4, "completion_tokens": 0, "total_tokens": len(prompt) // 4}

        def chunk(delta, finish=None):
            d = {"id": cid, "object": "chat.completion.chunk", "created": created, "model": model,
                 "choices": [{"index": 0, "delta": delta, "finish_reason": finish}]}
            return "data: " + json.dumps(d, ensure_ascii=False) + "\n\n"

        if not body.get("stream"):
            try:
                text = await run(acc_id, prompt)
            except RuntimeError as e:
                return JSONResponse({"error": {"message": str(e), "type": "aihive_error"}}, status_code=502)
            content, calls = parse(text)
            msg = {"role": "assistant", "content": content or None}
            if calls:
                msg["tool_calls"] = calls
            usage["completion_tokens"] = len(text) // 4
            usage["total_tokens"] += usage["completion_tokens"]
            return {"id": cid, "object": "chat.completion", "created": created, "model": model,
                    "choices": [{"index": 0, "message": msg, "finish_reason": "tool_calls" if calls else "stop"}],
                    "usage": usage}

        async def gen():
            yield chunk({"role": "assistant", "content": ""})
            task = asyncio.create_task(run(acc_id, prompt))
            while not task.done():
                await asyncio.wait({task}, timeout=KEEPALIVE)
                if not task.done():
                    yield ": keepalive\n\n"
            try:
                text = task.result()
            except Exception as e:
                yield chunk({"content": "[AiHive error] " + str(e)}, "stop")
                yield "data: [DONE]\n\n"
                return
            content, calls = parse(text)
            for k in range(0, len(content), 400):
                yield chunk({"content": content[k:k + 400]})
            for n, c in enumerate(calls):
                yield chunk({"tool_calls": [{"index": n, "id": c["id"], "type": "function",
                                             "function": {"name": c["function"]["name"], "arguments": c["function"]["arguments"]}}]})
            yield chunk({}, "tool_calls" if calls else "stop")
            yield "data: [DONE]\n\n"

        return StreamingResponse(gen(), media_type="text/event-stream", headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"})

    return r
